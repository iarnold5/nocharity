# ==============================================================================
# NoCharity Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your project credentials from your Supabase Dashboard:
#    Project Settings -> API -> Project URL & Project API Keys (anon public)
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public/Anon API Key
# IMPORTANT SECURITY NOTICE:
# - Used by the Express web server and browser clients for public read-only access.
# - RLS (Row Level Security) guarantees public read-only access.
# - NEVER put your 'service_role' key in client code, public repos, or public-facing deployments!
SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (OPTIONAL — LOCAL MAINTAINER INGESTION ONLY)
# CRITICAL SECURITY WARNING:
# - NEVER expose this key to browser clients, frontends, or commit it to Git!
# - Used exclusively by local CLI maintainer scripts (`npm run ingest -- --commit`)
#   to bypass Row-Level Security when committing vetted updates to Supabase.
# - Keep commented out or blank if you are only running the web app or dry-run ingestion.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

